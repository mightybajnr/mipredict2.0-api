# Mi Predict API — server environment
# Copy to .env and fill in real values. NEVER commit the real .env file.

# Local development port
PORT=3000

# MySQL (Aiven). Host-only database credentials. Do not expose in browser code.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=25671
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Comma-separated allow-list of origins permitted to call this API with credentials.
# Local development: http://localhost:5173
# Production: https://mipredict.com
FRONTEND_URL=http://localhost:5173

# Optional. Number of proxy hops to trust (Render sets this behind its proxy).
# Leave unset for the default (1). Use 0/false to disable.
# TRUST_PROXY=1

# Optional. Comma-separated emails allowed to finalize match results.
# ADMIN_EMAILS=admin@mipredict.com

# Optional. Raw Aiven CA certificate (newline-safe). If unset the server reads
# certs/ca.pem from disk (and certs/ must then be present, e.g. mounted locally).
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Set to production by the platform (Render). Do not set manually in local .env.
# NODE_ENV=production

# --- API-Football integration (all server-side only) ---
# Required to enable fixture/result synchronization. Never expose to the
# frontend. When missing, sync endpoints return a clear 503 and the rest of
# the app keeps working.
# API_FOOTBALL_KEY=your-api-football-key

# API-Football v3 base URL (override only if the provider changes).
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Selected competitions and seasons to import (comma-separated). No
# competition list is hardcoded in code; configure it here.
# Example: Premier League (39), La Liga (140), Serie A (135).
# API_FOOTBALL_LEAGUES=39,140,135
# API_FOOTBALL_SEASONS=2025

# Request tuning (optional).
# API_FOOTBALL_TIMEOUT_MS=10000
# API_FOOTBALL_MAX_RETRIES=2
# API_FOOTBALL_RETRY_BASE_MS=500
# API_FOOTBALL_CACHE_TTL_MS=60000

# Automated synchronization (optional, disabled by default). Prefer an external
# scheduler (Render Cron Job) calling the admin sync endpoints. If enabled
# in-process, a MySQL advisory lock prevents duplicate loops across instances.
# When enabled, a run also fires immediately on startup (no waiting a full
# interval). The fixture sync imports a rolling date window (today-1 .. today+7)
# day-by-day and keeps only API_FOOTBALL_LEAGUES (or a small top-league default).
# SYNC_SCHEDULE_ENABLED=false
# SYNC_INTERVAL_MINUTES=30
# SYNC_FIXTURES_INTERVAL_MINUTES=1440

# One-shot fixture import when the server boots in production (default true).
# Populates the current date window on a fresh deploy even without the optional
# scheduler. Never runs in tests/dev. Set to false to disable.
# SYNC_ON_STARTUP=true