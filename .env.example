# Mi Predict API — server environment
# Copy to .env and fill in real values. NEVER commit the real .env file.

# Local development port
PORT=3000

# MySQL (Aiven). Host-only database credentials. Do not expose in browser code.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=25671
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Comma-separated allow-list of origins permitted to call this API with credentials.
# Local development: http://localhost:5173
# Production: https://mipredict.com
FRONTEND_URL=http://localhost:5173

# Optional. Number of proxy hops to trust (Render sets this behind its proxy).
# Leave unset for the default (1). Use 0/false to disable.
# TRUST_PROXY=1

# Optional. Comma-separated emails allowed to finalize match results.
# ADMIN_EMAILS=admin@mipredict.com

# Optional. Raw Aiven CA certificate (newline-safe). If unset the server reads
# certs/ca.pem from disk (and certs/ must then be present, e.g. mounted locally).
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Set to production by the platform (Render). Do not set manually in local .env.
# NODE_ENV=production